{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist-gjs",
    "rootDir": "src",
    "types": [],
    "allowJs": true
  },
  "include": [
    "src/main-gjs.ts",
    "src/globals.d.ts",
    "src/gjs/**/*.ts",
    "src/gjs/vendor/**/*.js"
  ]
}
